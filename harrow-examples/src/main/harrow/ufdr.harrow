implicit order = big

namespace com.keano.ufdr.v13

struct UFDRReport {
   1: required UFDRReportHeader header					<-
   2: required list<ServiceRecord> serviceRecordList 	<- to:$(header.reportLength - (if (header.msgFlags.extensionFlag) { header.extensionHeader.exHeadLength + 2 } else { 0 }) )
   3: transient i32 totalSize 							<- value:$(header.reportLength)
}


struct UFDRReportHeader
{
	 1: required byte version							<-
	 2: optional i64 notInSource 						<- ^^
	 3: required MSGType msgFlags						<-
	 _: transient i32 reportLength						<- uint16
	 4: required i16 ne_type							<- uint8
     5: required i16 interfaceType						<- uint8
	 6: required byte moduleId1							<- bits:4
	 7: required byte reserved2							<- bits:4
	 8: required i16 moduleId2							<- uint8
	 9: required i64  ne_id								<- uint32
	 10: UFDRReportExtensionHeader extensionHeader  	<- if $(msgFlags.extensionFlag)
}

struct MSGType 
{
	_: transient i16 bflag  					<- value:4
	1: required i16 msgType      				<-   bits:4
	2: required bool anonymousFlag      		<-   bits:1
	3: required bool realTimeMsg        		<-   bits:1
	4: required bool extensionFlag      		<-   bits:1
	5: required bool requestFlag       		    <-   bits:1
}



struct UFDRReportExtensionHeader
{
	1: required i16 exHeadType  				<-  bits:7
	2: required bool linkedExtension  			<-  bits:1
	3: optional i16 exHeadLength  				<-  uint8
	4: optional list<byte> exHeadValue  		<-  items:$(exHeadLength) 
}

struct ServiceRecord
{
	1: required ServiceRecordHeader recordHeader	<- 
	2: required ServiceRecordData content			<- 
}

union ServiceRecordData 
{
    1: UFDRBase ufdrBase							<- if $(ServiceRecord.recordHeader.recordType == 1)
    2: UFDRStats ufdrStats							<- if $(ServiceRecord.recordHeader.recordType == 2)
}


struct ServiceRecordHeader
{
	1: required i16 reserved					<-  uint8
	2: required i16 recordType					<-  uint8
	3: required i32 record_len					<-	uint16
	4: required i32 fixed_fields_len			<-  uint16
	5: optional i32 extraValue					<-  value:99
}

struct UFDRBase 
{
	1: required i64 asc_id						<-  
	2: required i64 tm_sec						<- uint32
	3: optional i32 tm_msec						<- uint16
	4: required i32 protocolCategory			<- uint16
	5: required i32 protocolApp					<- uint16
	6: required i32 protocolSubApp				<- uint16
	7: required list<byte> msisdn				<- bytes:8
	8: required i64 imsi						<-
	9: required list<byte> imeisv				<- bytes:8
	10: required i32 sampling_ratio				<- little uint16
	11: required i32 parse_ratio				<- uint16
	12: required i16 parse_sample_flag			<- uint8
	_:  transient byte ms_ip_len				<- 
	13: required string ms_ip					<- bytes:$(ms_ip_len) ~> [[ map(b => b & 0xFF).mkString(".") ]]
	_:  transient byte serv_ip_len				<- 
	14: required string serv_ip					<- bytes:$(serv_ip_len) ~> [[ map(b => b & 0xFF).mkString(".") ]] // apply function to Array[Byte]
	15: required i32 ms_port					<- uint16
	16: required i32 serv_port					<- uint16
	17: required i32 ip_proto					<- uint16
	_:  transient byte apn_len					<-
	18: required string apn						<- bytes:$(apn_len) ~> [[ mkString("") ]]
	19: required i32 chargingCharacteristics	<- uint16
	20: required i16 rat_type					<- uint8
	_:  transient byte sgsn_ip_len				<-
	21: required string sgsn_ip					<- bytes:$(sgsn_ip_len) ~> [[ map(b => b & 0xFF).mkString(".") ]]
	_:  transient byte ugw_ip_len				<-
	22: required string ugw_ip					<- bytes:$(ugw_ip_len) ~> [[ map(b => b & 0xFF).mkString(".") ]]
	23: required i32 eng_sub_protocol			<- uint16
	24: required list<TLVRecord> tlvRecords		<- to:$(ServiceRecord.recordHeader.record_len)
}

struct UFDRStats 
{
	1: required i64 asc_id						<- little int64
	2: required list<TLVRecord> tlvRecords		<- to:$(ServiceRecord.recordHeader.record_len)
}

struct TLVRecord
{
	1: required i16 reserved					<- uint8
	2: required i16 recordType					<- uint8
	3: required TLVRecordData content			<-
}


union TLVRecordData 
{
	1: TLVUliRecord tlvUliRecord					<- if $(TLVRecord.recordType == 1)
	2: TLVVolumeRecord tlvVolumeRecord				<- if $(TLVRecord.recordType == 2)
	3: TLVTimeRecord tlvTimeRecord					<- if $(TLVRecord.recordType == 3)
	4: TLVPCCRuleRecord tlvPCCRuleRecord			<- if $(TLVRecord.recordType == 4)
	5: TLVBwmRuleRecord tlvBwmRuleRecord			<- if $(TLVRecord.recordType == 5)
	6: TLVBlockRecord tlvBlockRecord				<- if $(TLVRecord.recordType == 6)
	7: TLVBrowsingRecord tlvBrowsingRecord			<- if $( ((TLVRecord.recordType == 128) || (TLVRecord.recordType == 129)) )
	8: TLVChargingRecord tlvChargingRecord			<- if $(TLVRecord.recordType == 7)
	9: TLVCongestionRecord tlvCongestionRecord		<- if $(TLVRecord.recordType == 8)
	10: TLVSMTPRecord tlvSMTPRecord					<- if $(TLVRecord.recordType == 132)
	11: TLVMMSRecord tlvMMSRecord					<- if $(TLVRecord.recordType == 130)
	12: TLVSIPRecord tlvSIPRecord					<- if $(TLVRecord.recordType == 133)
	13: TLVOtherRecord tlvOtherRecord				<- 
}

struct TLVUliRecord 
{
 	1: required i32  uli_len						<- uint16			
	2: required UliFlag setFlags					<-
	3: optional MccMnc cgi_mcc						<- if $(setFlags.cgi)
	4: optional i32 cgi_lac							<- uint16  if $(setFlags.cgi)
	5: optional i32 cgi_ci							<- uint16  if $(setFlags.cgi)
	6: optional MccMnc sai_mcc						<- if $(setFlags.sai)
	7: optional i32  sai_lac						<- uint16  if $(setFlags.sai)
	8: optional i32 sai_sac							<- uint16  if $(setFlags.sai)
	9: optional MccMnc rai_mcc						<- if $(setFlags.rai)
	10: optional i32 rai_lac						<- uint16  if $(setFlags.rai)
	11: optional i32 rai_rac						<- uint16  if $(setFlags.rai)
	12: optional MccMnc tai_mcc						<- if $(setFlags.tai)
	13: optional i32 tai_tac						<- uint16  if $(setFlags.tai)
	14: optional MccMnc ecgi_mcc					<- if $(setFlags.ecgi)
	15: optional i32 ecgi_eci						<- uint16  if $(setFlags.ecgi)
	16: optional MccMnc lai_mcc						<- if $(setFlags.lai)
	17: optional i32 lai_lac						<- uint16  if $(setFlags.lai)
}


struct UliFlag 
{
	1: required byte spare						<- bits:2
	2: required bool lai						<- bits:1
	3: required bool ecgi						<- bits:1
	4: required bool tai						<- bits:1
	5: required bool rai						<- bits:1
	6: required bool sai						<- bits:1
	7: required bool cgi						<- bits:1
}

struct MccMnc 
{
	_: transient i16 _mcc1						<- bits:4
	_: transient i16 _mcc2						<- bits:4
	_: transient i16 _mcc3						<- bits:4		
	1: required  i32 mcc						<- value:$( _mcc1 * 100 + _mcc2 * 10 + _mcc3 ) 
	_: transient i16 _mnc1						<- bits:4
	_: transient i16 _mnc2						<- bits:4
	_: transient i16 _mnc3						<- bits:4
	2: required  i32 mnc					    <- value:$( if (_mnc3 == 0xF) { _mnc1 * 10 + _mnc2 } else { _mnc1 * 100 + _mnc2 * 10 + _mcc3 } ) 
}
  
struct TLVVolumeRecord
{
	1: required i32 vol_len						<- uint16
	2: required i64 uplink_high					<- uint32
	3: required i64 uplink_low					<- uint32
	4: required i64 download_high				<- uint32
	5: required i64 download_low				<- uint32			
	6: required i64 uplink_packets				<- uint32
	7: required i64 download_packets			<- uint32
}

struct TLVTimeRecord 
{
	1: required i32 time_len					<- uint16
	_: transient i16 spare						<- big bits:6
	2: required bool trans_flag					<- big bits:1
	3: required bool flow_flag					<- big bits:1
	4: required i64 start_sec					<- uint32
	5: required i32 start_msec					<- uint16
	6: required i64 end_sec						<- uint32
	7: required i32 end_msec					<- uint16
}

struct TLVPCCRuleRecord 
{
	1: required i32 rule_len					<- uint16
	_: transient i16 rule_name_len				<- uint8
	2: required string rule_name				<- bytes:$(rule_name_len) ~> [[ mkString("") ]]
	_: transient i16 rule_base_name_len			<- uint8
	3: required string rule_base_name			<- bytes:$(rule_base_name_len) ~> [[ mkString("") ]]
	4: required i32 uplinkActionbitsmap			<- uint16
	5: required i32 downlinkActionbitsmap		<- uint16
	6: required i16 typeIndicator				<- uint8
}

struct TLVBwmRuleRecord 
{
	1: required i32 bwm_rule_len				<- uint16
	2: required i64 user_grp_id					<- uint32
	3: required i64  user_id					<- uint32
}
  
struct TLVBlockRecord 
{
	1: required i32 blk_len						<- uint16
	2: required i16 blk_cause					<- uint8
	3: required i16 action						<- uint8
	4: required i64 uplink_volume				<- uint32
	5: required i64 download_volume				<- uint32
	6: required i64 uplink_packets				<- uint32
	7: required i64 download_packets			<- uint32
}
  
struct TLVBrowsingRecord 
{
	1: required i32 browse_len				 	<- uint16
	_: transient i32 host_len					<- uint16				
	_: transient i32 path_len					<- uint16
	2: optional string url						<- bytes:$(host_len + path_len) ~> [[ mkString("") ]]
	_: transient i32 agent_len				    <- uint16
	3: optional string agent					<- bytes:$(agent_len) ~> [[ mkString("") ]]
}

struct TLVChargingRecord 
{
	1: required i32 charge_len					<- uint16
	2: required i64 onlineRGId					<- uint32
	3: required i64 onlineServiceId				<- uint32
	4: required i64 offlineRGId					<- uint32
	5: required i64 offlineServiceId			<- uint32
}

struct TLVCongestionRecord
{
	1: required i32 congestion_len				<- uint16
	2: required i16 congestionLevel				<- uint8
}

struct TLVSMTPRecord
{
    1: required i32 smtp_len					<- uint16
	2: required i16 to_number					<- uint8
	3: required i16 cc_number					<- uint8
	_: transient i32 send_addr_len				<- uint16
	4: optional string send_addr				<- bytes:$(send_addr_len) ~> [[ mkString("") ]]
	_: transient i32 recv_addr_len				<- uint16
	5: optional string recv_addr				<- bytes:$(recv_addr_len) ~> [[ mkString("") ]]
	_: transient i32 cc_addr_len				<- uint16
	6: optional string cc_addr					<- bytes:$(cc_addr_len) ~> [[ mkString("") ]]
	_: transient i32 agent_len					<- uint16
	7: optional string agent					<- bytes:$(agent_len) ~> [[ mkString("") ]]
}

struct TLVMMSRecord
{
	1: required i32 mms_len						<- uint16
	_: transient i32 host_len					<- uint16
	_: transient i32 path_len					<- uint16
	3: optional string url						<- bytes:$(host_len + path_len) ~> [[ mkString("") ]]
	4: optional i16 method						<- uint8
}

struct TLVSIPRecord
{
	1: required i32 sip_len						<- uint16
	2: required i16 to_number					<- uint8
	_: transient i16 from_len					<- uint8
	3: optional string from						<- bytes:$(from_len) ~> [[ mkString("") ]]
	_: transient i16 to_len						<- uint8
	4: optional string to						<- bytes:$(to_len) ~> [[ mkString("") ]]
	_: transient i32 agent_len					<- uint16		
	5: optional string agent					<- bytes:$(agent_len) ~> [[ mkString("") ]]
}

struct TLVOtherRecord
{
 	_: transient i32 tlv_len					<- uint16
	1: required list<byte> tlvValue				<- bytes:$(tlv_len)
}
